{
  "name": "@solvchat/admin",
  "version": "0.0.0",
  "description": "React admin app and mountable extension library for solv.chat.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/integry/solv.chat.git",
    "directory": "packages/admin"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./styles.css": "./lib/styles.css",
    "./preview.html": "./dist/preview.html",
    "./preview.js": "./dist/preview.js",
    "./preview.css": "./dist/preview.css"
  },
  "files": [
    "dist",
    "lib"
  ],
  "scripts": {
    "dev": "vite",
    "pretypecheck": "npm run build -w @solvchat/core --if-present",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @solvchat/core --if-present",
    "test": "vitest run",
    "prebuild": "npm run build -w @solvchat/core --if-present",
    "build": "vite build && tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs => fs.copyFileSync('src/styles.css', 'lib/styles.css'))\""
  },
  "dependencies": {
    "@solvchat/core": "^0.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.1",
    "happy-dom": "^17.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  }
}
