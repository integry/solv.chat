{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solvchat-engine",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // Secrets (set via `wrangler secret put` or `.dev.vars` locally; never commit values):
  //   SOLV_ADMIN_PASSWORD
  //   SOLV_SECRET_KEY
  //   SOLV_ANTHROPIC_KEY
  //   SOLV_OPENAI_KEY
  "vars": {
    "SOLV_LLM_PROVIDER": "anthropic",
    "SOLV_LLM_TIER": "fast"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solvchat",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORS",
      "index_name": "solvchat-chunks"
      // Metadata indexes required before first ingest: org_id (string), assistant_id (string)
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "solvchat-docs"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "solvchat-ingest"
      }
    ],
    "consumers": [
      {
        "queue": "solvchat-ingest",
        // Workers Free allows 50 external subrequests per invocation (1,000 for Cloudflare bindings);
        // each message makes ~9 binding/network calls (D1, R2, OpenAI embed, Vectorize), so 4 keeps
        // a full batch within the Free limit.
        // Sources (checked 2026-11-15):
        //   https://developers.cloudflare.com/queues/configuration/configure-queues/
        //   https://developers.cloudflare.com/workers/platform/limits/
        "max_batch_size": 4,
        "dead_letter_queue": "solvchat-ingest-dlq"
      }
    ]
  }
}
