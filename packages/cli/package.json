{
  "name": "@solvchat/cli",
  "version": "0.0.0",
  "description": "CLI and GitHub Action for pushing content and running answer tests on solv.chat.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/integry/solv.chat.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "solv": "./bin/solv.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "action"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@solvchat/core": "^0.0.0"
  },
  "scripts": {
    "pretypecheck": "npm run build -w @solvchat/core --if-present",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @solvchat/core --if-present",
    "test": "vitest run",
    "prebuild": "npm run build -w @solvchat/core --if-present",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
