{
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/lib",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/widgetBundle.ts",
      "!**/adminBundle.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": [
        "packages/engine/src/**",
        "!packages/engine/src/index.ts",
        "!packages/engine/src/worker.ts",
        "!packages/engine/src/seams/open/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/seams/open/**"],
                    "message": "Only src/worker.ts imports the open seam implementations; createApp(seams) must not depend on them."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
